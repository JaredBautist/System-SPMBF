DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local (Django corriendo en host con MySQL local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=libraryfesc
DB_USER=root
DB_PASSWORD=1234
DB_ROOT_PASSWORD=rootpass

# Si usas MySQL dentro de Docker pero Django en host, expuesto en 3307:
# DB_HOST=localhost
# DB_PORT=3307

# Si corrieras Django dentro del contenedor, usa el hostname del servicio y puerto interno 3306:
# DB_HOST=db
# DB_PORT=3306

TIME_ZONE=America/Bogota
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RESERVATION_MIN_DURATION_MINUTES=30
RESERVATION_MAX_DURATION_HOURS=4
